# CAO 48.1 Compliance API — Environment Variables
# Copy to .env and fill in values.

# Runtime environment: "development" or "production"
# Development skips RapidAPI proxy secret validation.
ENVIRONMENT=development

# API version — shown in /health response and OpenAPI spec.
API_VERSION=0.1.0

# RapidAPI proxy secret — from your Provider Dashboard > Security tab.
# Required in production; leave blank for local development.
RAPIDAPI_PROXY_SECRET=

# Logging level: debug, info, warning, error
LOG_LEVEL=info